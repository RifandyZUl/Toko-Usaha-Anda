# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=public"

# JWT Configuration
JWT_SECRET="your_jwt_secret_key_at_least_32_characters_long"
JWT_EXPIRES_IN="7d"

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000,http://localhost:3001"

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=product-images

# Midtrans Configuration
MIDTRANS_SERVER_KEY="your-midtrans-server-key"
MIDTRANS_CLIENT_KEY="your-midtrans-client-key"
MIDTRANS_IS_PRODUCTION=false

# Courier Tracking API (BinderByte / RajaOngkir)
# Get your API key from: https://binderbyte.com (supports JNE, J&T, SiCepat, AnterAja, Pos, TIKI, etc.)
BINDERBYTE_API_KEY="your_binderbyte_api_key_here"

# WhatsApp OTP Gateway (Fonnte)
# Register at https://fonnte.com to send official automated OTP messages to customer WhatsApp.
# If left empty, the system runs in simulation mode (printing OTP to backend console).
FONNTE_TOKEN="your_fonnte_token_here"


