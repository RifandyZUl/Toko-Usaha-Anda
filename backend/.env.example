# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=public"
# Only for scripts/import_excel_products.js --supabase and scripts/sync_supabase_catalog.js (never hardcode it)
SUPABASE_DB_URL=""

# JWT Configuration
JWT_SECRET="your_jwt_secret_key_at_least_32_characters_long"

# Admin account created by `npm run prisma:seed` (password min. 12 characters; never commit real values)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
JWT_EXPIRES_IN="7d"

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000,http://localhost:3001"

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=product-images

# Midtrans Configuration
MIDTRANS_SERVER_KEY="your-midtrans-server-key"
MIDTRANS_CLIENT_KEY="your-midtrans-client-key"
MIDTRANS_IS_PRODUCTION=false

# BinderByte API Key (wajib): https://binderbyte.com
# Dipakai untuk data wilayah, ongkir tarif resmi kurir, dan cek resi. Checkout tidak bisa jalan tanpa ini.
BINDERBYTE_API_KEY="your_binderbyte_api_key_here"

# WhatsApp OTP Gateway (Fonnte)
# Register at https://fonnte.com to send official automated OTP messages to customer WhatsApp.
# If left empty, the system runs in simulation mode (printing OTP to backend console).
FONNTE_TOKEN="your_fonnte_token_here"
# Random secret (e.g. `openssl rand -hex 32`). Set the Fonnte dashboard webhook URL to
# https://<backend>/api/webhook/fonnte?secret=<this value>. Required outside development.
FONNTE_WEBHOOK_SECRET=""

# Gmail SMTP Email OTP Configuration
# Gunakan Google Account App Password (16 karakter) dari https://myaccount.google.com/apppasswords
# Jika dikosongkan, sistem berjalan dalam mode simulasi (kode OTP tercetak di konsol backend).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="Toko Usaha Anda <your-email@gmail.com>"


