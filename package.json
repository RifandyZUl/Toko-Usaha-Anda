{
  "name": "toko-usaha-anda-monorepo",
  "version": "2.0.0",
  "description": "Monorepo untuk Landing Page dan E-Commerce Toko Usaha Anda",
  "type": "module",
  "private": true,
  "workspaces": [
    "frontend/*",
    "shared",
    "backend"
  ],
  "scripts": {
    "dev:landing": "npm run dev --workspace=frontend/landing",
    "dev:shop": "npm run dev --workspace=frontend/shop",
    "dev:admin": "npm run dev --workspace=frontend/admin",
    "dev:backend": "npm run dev --workspace=backend",
    "dev": "npm run dev:landing",
    "build:landing": "npm run build --workspace=frontend/landing",
    "build:shop": "npm run build --workspace=frontend/shop",
    "build:admin": "npm run build --workspace=frontend/admin",
    "build": "npm run build:landing && npm run build:shop && npm run build:admin",
    "preview:landing": "npm run preview --workspace=frontend/landing",
    "preview:shop": "npm run preview --workspace=frontend/shop",
    "preview:admin": "npm run preview --workspace=frontend/admin",
    "seed": "npm run seed --workspace=backend",
    "update:category": "npm run update:category --workspace=backend",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{js,jsx,css,md}\""
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "lucide-react": "^0.294.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "tailwindcss": "^3.3.6",
    "vite": "^5.0.8"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "react",
    "vite",
    "tailwindcss",
    "landing-page",
    "responsive",
    "modern",
    "e-commerce"
  ],
  "author": "3 Macam 10.000",
  "license": "MIT"
}
